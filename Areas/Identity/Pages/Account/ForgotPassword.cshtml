@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Восстановление пароля";
    ViewData["HideSidebars"] = true; // Скрываем боковые колонки
    Layout = "/Views/Shared/_Layout.cshtml"; // Основной макет
}
<div class="d-flex justify-content-center align-items-start min-vh-100 bg-light" style="padding-top: 10vh;">
    <div class="bg-white p-4 rounded shadow w-100" style="max-width: 420px;">
        <h1 class="h4 text-center">@ViewData["Title"]</h1>
        <h2 class="h6 text-center mb-4">Введите свой мейл, указанный при регистрации.</h2>
        <hr />
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

            <div class="form-floating mb-3">
                <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                <label asp-for="Input.Email">Email</label>
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            <button type="submit" class="w-100 btn btn-primary btn-lg">Изменить пароль</button>
        </form>
    </div>
</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
