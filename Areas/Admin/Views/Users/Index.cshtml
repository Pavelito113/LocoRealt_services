@using LocoRealt.Models
@model List<UserViewModel> 

<table class="table">
    <thead>
        <tr>
            <th>Email</th>
            <th>Роли</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td>@user.Email</td>
                <td>@string.Join(", ", user.Roles ?? Enumerable.Empty<string>())</td>
            </tr>
        }
    </tbody>
</table>