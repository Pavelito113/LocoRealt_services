@model LocoRealt.Models.CreateListingViewModel

<div class="card mb-4">
    <div class="card-header">Характеристики квартиры</div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-6">
                <div class="mb-3">
                    <label asp-for="Rooms" class="form-label">Количество комнат</label>
                    <input asp-for="Rooms" class="form-control" type="number" />
                </div>

                <div class="mb-3">
                    <label asp-for="TotalArea" class="form-label">Общая площадь (м²)</label>
                    <input asp-for="TotalArea" class="form-control" type="number" step="0.1" />
                </div>

                <div class="mb-3">
                    <label asp-for="FloorNum" class="form-label">Этаж</label>
                    <input asp-for="FloorNum" class="form-control" type="number" />
                </div>
            </div>

            <div class="col-md-6">
                <div class="mb-3">
                    <label asp-for="TotalFloors" class="form-label">Этажей в доме</label>
                    <input asp-for="TotalFloors" class="form-control" type="number" />
                </div>

                <div class="mb-3 form-check">
                    <input asp-for="IsStudio" class="form-check-input" />
                    <label asp-for="IsStudio" class="form-check-label">Студия</label>
                </div>


                <div class="col-12 mt-2">
                    <label asp-for="Balcony" class="form-label"></label>
                    <select asp-for="Balcony" asp-items="Model.BalconyOptions" class="form-select"></select>
                    <span asp-validation-for="Balcony" class="text-danger"></span>
                </div>

            </div>
        </div>
    </div>
</div>