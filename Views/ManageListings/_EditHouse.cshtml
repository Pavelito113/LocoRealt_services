@model LocoRealt.Models.CreateListingViewModel

<div class="card mb-4">
    <div class="card-header">Характеристики дома</div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-6">
                <div class="mb-3">
                    <label asp-for="HouseArea" class="form-label">Площадь дома (м²)</label>
                    <input asp-for="HouseArea" class="form-control" type="number" step="0.1" />
                </div>

                <div class="mb-3">
                    <label asp-for="LandArea" class="form-label">Площадь участка (соток)</label>
                    <input asp-for="LandArea" class="form-control" type="number" step="0.1" />
                </div>
            </div>

            <div class="col-md-6">
                <div class="mb-3">
                    <label asp-for="FloorCount" class="form-label">Количество этажей</label>
                    <input asp-for="FloorCount" class="form-control" type="number" />
                </div>

                <div class="mb-3">
                    <label asp-for="WallMaterial" class="form-label">Материал стен</label>
                    <select asp-for="WallMaterial" class="form-select">
                        <option value="Кирпич">Кирпич</option>
                        <option value="Дерево">Дерево</option>
                        <option value="Блоки">Блоки</option>
                    </select>
                </div>
            </div>
        </div>
    </div>
</div>