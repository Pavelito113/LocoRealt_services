@using LocoRealt.Models
@model IEnumerable<ListingItemDto>

@{
    var currentUrl = Context.Request.Path + Context.Request.QueryString;
    var idList = string.Join(",", Model.Select(l => l.ListingId));
}

<style>
    .listings-horizontal {
        display: flex;
        overflow-x: auto;
        gap: 1rem;
        padding: 0.5rem 0;
        scrollbar-width: thin;
        scrollbar-color: var(--sale-text) transparent;
    }

    .rent-mode .listings-horizontal {
        scrollbar-color: var(--rent-text) transparent;
    }

    .listing-card {
        flex: 0 0 300px;
        display: flex;
        flex-direction: column;
        border-radius: 10px;
        overflow: hidden;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        transition: transform 0.3s, box-shadow 0.3s;
        background: white;
    }

        .listing-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 5px 15px rgba(0,0,0,0.15);
        }

    .listing-image-container {
        height: 180px;
        position: relative;
    }

        .listing-image-container img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.5s;
        }

    .listing-card:hover .listing-image-container img {
        transform: scale(1.03);
    }

    .listing-content {
        padding: 1rem;
        flex-grow: 1;
        display: flex;
        flex-direction: column;
    }

    .listing-title {
        font-size: 1.1rem;
        margin-bottom: 0.5rem;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .listing-price {
        font-size: 1.2rem;
        font-weight: bold;
        margin-bottom: 0.5rem;
    }

    .listing-features {
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
        margin-bottom: 0.5rem;
    }

        .listing-features span {
            font-size: 0.85rem;
        }

    .listing-footer {
        margin-top: auto;
        padding-top: 0.8rem;
        border-top: 1px solid rgba(0,0,0,0.05);
    }

    /* Кастомный скроллбар */
    .listings-horizontal::-webkit-scrollbar {
        height: 6px;
    }

    .listings-horizontal::-webkit-scrollbar-track {
        background: transparent;
    }

    .listings-horizontal::-webkit-scrollbar-thumb {
        background-color: var(--sale-text);
        border-radius: 3px;
    }

    .rent-mode .listings-horizontal::-webkit-scrollbar-thumb {
        background-color: var(--rent-text);

    }
</style>

<div class="listings-horizontal">
    @foreach (var item in Model)
    {
        var dealType = item.IsForRent ? "Аренда" : "Продажа";
        var badgeClass = item.IsForRent ? "bg-warning" : "bg-success";
        var placeholderImage = item.IsForRent ? "/images/rent-placeholder.jpg" : "/images/sale-placeholder.jpg";

        <div class="listing-card @(item.IsForRent ? "rent" : "sale")">
            <div class="listing-image-container">
                <a asp-controller="Listings"
                   asp-action="Details"
                   asp-route-id="@item.ListingId"
                   asp-route-dealType="@(item.IsForRent ? "rent" : "sale")"
                   asp-route-returnUrl="@currentUrl"
                   asp-route-ids="@idList">

                    <img src="@Url.Action("GetByListingId", "Images", new { listingId = item.ListingId })"
                         alt="@item.TxtTitle"
                         loading="lazy"
                         width="300"
                         height="200"
                         style="object-fit: cover; background: #f0f0f0;"
                         onerror="this.onerror=null;this.src='@Url.Content("~/images/no-image.png")'" />
                                             
                     </a>


                @if (!string.IsNullOrEmpty(item.Status))
                {
                    <span class="position-absolute top-0 start-0 m-2 badge bg-info">@item.Status</span>
                }
            </div>

            <div class="listing-content">
                <h3 class="listing-title">
                    <a asp-controller="Listings"
                       asp-action="Details"
                       asp-route-id="@item.ListingId"
                       asp-route-dealType="@(item.IsForRent ? "rent" : "sale")"
                       asp-route-returnUrl="@currentUrl"
                       asp-route-ids="@idList"
                       class="text-decoration-none text-dark">
                        @item.TxtTitle.Trim()
                    </a>
                </h3>

                <p class="listing-price @(item.IsForRent ? "text-purple" : "text-primary")">
                    @item.DblPrice.ToString("N0") ₽
                    @if (item.IsForRent)
                    {
                        <span class="text-muted small">/мес</span>
                    }
                </p>

                <div class="listing-features">
                    <span class="badge @badgeClass">@dealType</span>

                    @if (item.IsBargain)
                    {
                        <span class="badge bg-danger">Торг</span>
                    }

                    @if (item.Rooms.HasValue)
                    {
                        <span class="text-muted">
                            <i class="fas fa-door-open"></i>
                            @item.Rooms @(item.Rooms.Value == 1 ? "комната" : item.Rooms.Value < 5 ? "комнаты" : "комнат")
                        </span>
                    }

                    @if (item.TotalArea.HasValue)
                    {
                        <span class="text-muted">
                            <i class="fas fa-ruler-combined"></i>
                            @item.TotalArea.Value.ToString("N0") м²
                        </span>
                    }
                </div>

                @if (!string.IsNullOrEmpty(item.Location))
                {
                    <p class="text-muted small mb-2">
                        <i class="fas fa-map-marker-alt"></i> @item.Location
                    </p>
                }

                <div class="listing-footer d-flex justify-content-between align-items-center">
                    <span class="text-muted small">
                        <i class="far fa-clock me-1"></i>
                        <time datetime="@item.DtCreated.ToString("yyyy-MM-dd")">@item.DtCreated.ToString("dd.MM.yyyy")</time>
                    </span>

                    <a class="btn btn-sm @(item.IsForRent ? "btn-outline-purple" : "btn-outline-primary") rounded-pill px-3 details-btn"
                       asp-controller="Listings"
                       asp-action="Details"
                       asp-route-id="@item.ListingId"
                       asp-route-dealType="@(item.IsForRent ? "rent" : "sale")"
                       asp-route-returnUrl="@currentUrl"
                       asp-route-ids="@idList">
                        Подробнее <i class="fas fa-chevron-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>
    }
</div>